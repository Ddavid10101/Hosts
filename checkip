#!/bin/bash

verifica_ip() {
  nslookup "$1" "$3" | grep Address | grep -v '#' | awk '{print $2}' | grep -qx "$2"
}

cat /etc/hosts | while read ip nume; do
  case "$ip" in
    ""|\#*|127.*|*:*) continue ;;
  esac

  if ! verifica_ip "$nume" "$ip" 8.8.8.8; then
    echo "Bogus IP for $nume in /etc/hosts!"
  fi
done
